<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sandbox</RootNamespace>
    <AssemblyName>Sandbox</AssemblyName>
    <Version>0.12.5</Version>
    <!-- Desktop game, not a server: workstation non-concurrent GC (no background GC thread) and a tighter heap. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="external/**" />
    <None Remove="external/**" />
    <EmbeddedResource Remove="external/**" />
  </ItemGroup>

  <!-- RID-specific publish flattens natives into the app folder but skips Prowl's loose
       Libraries/<rid>/native files (miniaudioex), so copy them next to the executable. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None Include="external/Prowl/Libraries/$(RuntimeIdentifier)/native/*" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="external/Prowl/Prowl.Runtime/Prowl.Runtime.csproj" />
  </ItemGroup>

</Project>
